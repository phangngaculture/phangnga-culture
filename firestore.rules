rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for validating statuses and integrity
    function isValidStatus(status) {
      return status in ['pending', 'pending_director', 'pending_admin', 'approved', 'in_progress', 'completed', 'rejected', 'cancelled'];
    }

    // Official vehicle management collections - Phangnga Provincial Cultural Office
    match /bookings/{bookingId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    match /vehicles/{vehicleId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    match /fuelLogs/{logId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    match /maintenanceRecords/{recordId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    match /passengers/{passengerId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    match /systemSettings/{settingId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Health check & connection validation collection
    match /test/{docId} {
      allow read, write: if true;
    }

    // Catch-all for subcollections or future entities
    match /{document=**} {
      allow read, write: if true;
    }
  }
}


